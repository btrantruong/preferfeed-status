# Per-machine values (copy to config.local.env, which git ignores). Format: KEY=VALUE, no quotes.
# Label written to run.log, the history and the commit message, e.g. barnard or laptop.
MACHINE=laptop
# Clone of preferfeed_dataaccess; its DB reader (SubsetReader) is imported from here.
PFDA_DIR=/path/to/preferfeed_dataaccess
# Credentials file (never inside this repo).
CREDS=/path/to/preferfeed_dataaccess/creds.yml
# Output folder for row-level and history files; must be outside this repo.
OUTDIR=/path/to/preferfeed_dataaccess/2026-11-24-status-dashboard/output_laptop
# Absolute path to uv (command -v uv).
UV=/path/to/uv
# Optional. Runtime inventory parquet for the spot check cards (inventory/inventory_drop.parquet of the project).
INVENTORY_FILE=
# Optional. live (default) or export:FOLDER to replay an export (CC/window/table.parquet); then PULLED_AT is required.
# Use with: ./run.sh --no-push --set SOURCE=export:FOLDER --set PULLED_AT=2026-11-21T00:00:00Z

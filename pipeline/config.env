# Run parameters shared by all machines (committed). Format: KEY=VALUE, no quotes.
# Override a value for one run with: ./run.sh --set KEY=VALUE
# Start of fielding; participants with visited_users.created_at >= LAUNCH are counted. Naive time, read in TZ.
LAUNCH=2026-11-25T09:30
# Timezone for LAUNCH and for the times shown on the page. Data files are in UTC.
TZ=Europe/Berlin
COUNTRIES=UK,DE,FR,PL
# Countries queried in a run (a subset of COUNTRIES; empty or missing = all). The others are not contacted and keep their
# last published data. Per run: ./run.sh --countries UK,DE (same as --set PULL_COUNTRIES=UK,DE).
PULL_COUNTRIES=
# Countries that launch later than LAUNCH: country:time pairs (naive, read in TZ), e.g. DE:2026-11-27T10:00,FR:2026-11-29T10:00.
# LAUNCH is the earliest launch and the start of the time axis; a country without an entry is counted from LAUNCH.
LAUNCH_BY_COUNTRY=
# Country -> key in creds.yml
CREDS_KEYS=UK:uk_database,DE:ger_database,FR:fr_database,PL:pol_database
# Slider step and bin width in minutes; bins start at LAUNCH.
BIN_MINUTES=15
# Incomplete participants created less than SESSION_MIN minutes before the pull are "possibly in session".
SESSION_MIN=15
# Error codes that do not count as "error logged" (comma separated).
IGNORE_CODES=NOT_FOUND
# Stopping codes for the cancelled reason (label:code); the last one in the error log wins.
STOP_CODES=bot:AUTOMATED_BROWSER_DETECTED,idle:IDLE_DETECTED,reload:PAGE_RELOAD_DETECTED
# App thresholds for idle detection, shown in the info panel (WINDOW_FOCUSED_THRES, VIEWED_POST_THRES).
IDLE_MIN_SECONDS=360
IDLE_MIN_POSTS=20
# Minutes after which the page warns that the data is old; empty = no warning (manual pulls).
STALE_AFTER_MIN=
# Page auto-refresh interval in minutes.
REFRESH_MIN=2
# Seconds before a DB connection attempt gives up.
CONNECT_TIMEOUT_S=10
# Warn if the last data push is younger than this (GitHub Pages: about 10 builds per hour).
MIN_PUSH_GAP_MIN=6
SCRIPTS_URL=https://github.com/btrantruong/preferfeed-status/tree/main/pipeline
GIT_REMOTE=origin
GIT_BRANCH=main

# ---- status page panels (chart and detail-pull parameters; defaults are in config.py) ----
# Event charts (se1, se5, ap1): bin width in minutes. Must divide BIN_MINUTES.
EVENT_BIN_MINUTES=5
# dc1: bin width in minutes (a multiple of BIN_MINUTES); hours with fewer done participants than MIN_N_RATE are faded.
FLAG_BIN_MINUTES=60
MIN_N_RATE=5
# dc2: record_entry rows per done participant, bin width and the start of the open last bin.
RECORDS_BIN_WIDTH=2000
RECORDS_MAX=50000
# dc3: requests per participant (open last bin) and posts per batch of the timeline.
REQUESTS_MAX=40
BATCH_SIZE=5
DIFF_RANGE=10
# cs2: this many timeline starts and more share one bar; records of the final attempt start ATTEMPT_MARGIN_S before its init.
ATTEMPTS_MAX=4
ATTEMPT_MARGIN_S=10
# se3: minutes since session creation, bin width and open last bin.
ERROR_AGE_BIN_MIN=1
ERROR_AGE_MAX_MIN=20
SERVER_ERROR_CODE=SERVER_ERROR
CLIENT_ERROR_CODES=CLIENT_TRACKING_SEND_FAILED,CLIENT_FEED_INIT_FAILED,CLIENT_FEED_BATCH_LOAD_FAILED
# se2: first k error runs per participant; codes left out of the flow (empty = all codes).
FLOW_STEPS=4
FLOW_EXCLUDE_CODES=
# ap2: last request_index shown.
WARMUP_MAX_INDEX=10
# User spot check (local preview only): list size per country, minimum next_batch exchanges for the default pick.
SPOT_MAX_USERS=30
SPOT_MIN_REQUESTS=10
SPOT_TEXT_MAX_CHARS=2000
# sp2: a post's point size grows with its dwell time up to this many seconds.
SPOT_DWELL_CAP_S=30
# Panel D (spot check) is public: on publishes spot_users.json (participants identified by database id, the posts they saw and
# their dwell times) with the data when a run produced it; off does not publish it and removes a published copy.
SPOT_PUBLISH=on
# Detail pull (record_entry, algo_exchange): off, basic (rows per participant, exchanges, spot check) or full (adds active participants).
DETAIL=full
DETAIL_TIMEOUT_S=60
# Warn when a published file is larger than this.
# Sessions (panel B pages 3 to 5, local ids report): bins of the time-on-feed and attempt histograms, in seconds (bin 0 is below the
# first edge, the last bin is open).
DURATION_EDGES_S=10,60,120,180,240,300,360,420,480,540,600,660,720,780,840,900
# A participant who is not done or cancelled is in session while the time since entry is below T_ref, the SESSION_REF_QUANTILE
# value of entry to last record of done participants (once SESSION_REF_MIN_N are done; before that SESSION_REF_FALLBACK_MIN minutes).
SESSION_REF_QUANTILE=0.95
SESSION_REF_MIN_N=30
SESSION_REF_FALLBACK_MIN=10
# time: the rule above decides in session or left; silence: a last record at most SESSION_SILENCE_S old means in session.
SESSION_RULE=time
SESSION_SILENCE_S=90
# record_entry is read in record_id ranges of this size (the first run is resumable).
RECORD_CHUNK_IDS=200000
# ids report: stays shorter than these many seconds.
SHORT_STAY_S=10,60
MAX_FILE_KB=2000
